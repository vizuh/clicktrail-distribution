{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClickTrail Machine Distribution Report",
  "type": "object",
  "required": [
    "schemaVersion",
    "reports"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "reports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "schemaVersion",
          "caseId",
          "stageResults",
          "findings",
          "nextActions",
          "unknowns",
          "redactionPassed"
        ],
        "properties": {
          "schemaVersion": {
            "const": "1.0.0"
          },
          "caseId": {
            "type": "string"
          },
          "stageResults": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "stage",
                "status",
                "evidenceRef"
              ],
              "properties": {
                "stage": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "pass",
                    "fail",
                    "unknown"
                  ]
                },
                "evidenceRef": {
                  "type": "string"
                }
              }
            }
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "nextActions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "unknowns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "redactionPassed": {
            "const": true
          }
        }
      }
    }
  }
}
